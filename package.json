{
  "name": "steam_log_visualizer",
  "version": "1.0.0",
  "private": true,
  "description": "Steam log visualizer",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "lint": "eslint . --ext .ts,.js",
    "format": "prettier -w .",
    "test": "vitest run --passWithNoTests",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@types/d3-dsv": "^3.0.7",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.3.0",
    "@types/three": "^0.180.0",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitest/ui": "^3.2.4",
    "@webgpu/types": "^0.1.66",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-unused-imports": "^4.2.0",
    "husky": "^8.0.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^16.2.0",
    "prettier": "^3.6.2",
    "rollup-plugin-visualizer": "^6.0.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "d3-dsv": "^3.0.1",
    "echarts": "^6.0.0",
    "three": "^0.180.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier -w"
    ],
    "*.{json,md,css,scss,html}": [
      "prettier -w"
    ]
  }
}
